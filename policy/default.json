{
  "version": 1,
  "subscriptions": {
    "claude-personal": {
      "priority": 40,
      "agents": ["claude-code"],
      "models": {"allow": ["*"], "default": "claude-sonnet-5-5"}
    },
    "opencode-zen": {
      "priority": 10,
      "agents": ["opencode"],
      "models": {"allow": ["*-free", "big-pickle"], "default": "mimo-v2.6-flash-free"}
    },
    "opencode-go": {
      "priority": 15,
      "agents": ["opencode"],
      "models": {"allow": ["*-free"], "default": "beam-free"}
    },
    "openrouter": {
      "priority": 20,
      "agents": ["opencode"],
      "models": {"allow": ["*:free", "openrouter/free"], "default": "openrouter/free"}
    },
    "groq": {
      "priority": 25,
      "agents": ["opencode"],
      "models": {
        "allow": ["openai/gpt-oss-120b", "openai/gpt-oss-20b", "qwen/qwen3.8-27b"],
        "default": "openai/gpt-oss-120b"
      }
    },
    "ollama-cloud": {
      "priority": 30,
      "agents": ["claude-code", "opencode"],
      "models": {"allow": ["*"], "default": "deepseek-v4.1-flash"}
    }
