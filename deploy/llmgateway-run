#!/usr/bin/env bash
# llmgateway-run：讀 env 檔，組出 python3 -m lgwd 的 argv 並 exec。
# 工作目錄是 current（python 從 CWD 找到 lgwd 套件）。
set -uo pipefail

HOME_DIR="${HOME:?HOME 未設定}"
CURRENT="${HOME_DIR}/.local/share/llmgateway/current"
STATE="${HOME_DIR}/.local/state/llmgateway"
CONF="${HOME_DIR}/.config/llmgateway/llmgateway.env"

[[ -f "$CONF" ]] && . "$CONF"
API_PORT="${LGW_API_PORT:-8480}"

cd "$CURRENT" || exit 1
exec python3 -m lgwd \
    --db "${STATE}/llm.db" \
    --policy "${CURRENT}/policy/default.json" \
    --keys "${STATE}/keys.env" \
    --api-host 127.0.0.1 \
    --api-port "$API_PORT"
