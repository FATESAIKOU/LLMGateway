# LLMGateway check 失敗通知（#296）的設定範本。
#
# 用法：複製到 /etc/llmgateway/check-notify.env（root:root 0644），把四個值換成
# 這一台的設定。這裡的值都只是佔位，也都不是祕密（不得放 token、金鑰或任何身分檔
# 的路徑）。llmgateway-check-notify.service 用 EnvironmentFile= 讀這一份。
#
# 沒有這份檔案（或鍵不齊）：check 失敗時只會在 journal 寫一行
# "notify skipped: not configured"，不會送訊息；`llmgwctl check` 的 check-notify
# 項目會是 todo。
# 值仍是 place-holder-* 時視為未設定：腳本寫同一行 journal、不送訊息，
# llmgwctl check 的 check-notify 會提示是哪一個鍵還是佔位值。

# aicomm 的頻道與收件人（送一次訊息＝叫醒收件人一次）。
LGW_NOTIFY_CHANNEL=place-holder-channel
LGW_NOTIFY_TO=place-holder-recipient

# 送件身分（aicomm 讀的環境變數）。
ANGAREION_IDENTITY=place-holder-identity

# 這一台機器的代號：會填進通知訊息，讓 PMO 知道是哪一台。格式是
# [A-Za-z0-9._-]{1,32}（英數與 . _ -，1～32 字元）；格式不對就當成沒設：
# 腳本跳過不送（journal 一行 notify skipped: invalid label），
# llmgwctl check 的 check-notify 會是 todo。
LGW_NOTIFY_LABEL=place-holder-label
