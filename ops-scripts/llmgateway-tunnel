def read_bounded(path):
    """回 ("ok", 文字) / ("missing", None) / ("unreadable", None) / ("invalid", None)。
    只有檔案真的不存在才是 missing；權限不足是 unreadable；symlink、非一般檔、過大、
    不是 UTF-8 等都是 invalid（與 lgwctl.layout 的 _read_state 同語意）。"""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        return "missing", None
    except PermissionError:
        return "unreadable", None
    except OSError:
        return "invalid", None
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_size > MAX_STATE_BYTES:
            return "invalid", None
        data = os.read(fd, MAX_STATE_BYTES + 1)
        if len(data) > MAX_STATE_BYTES:
            return "invalid", None
        return "ok", data.decode("utf-8")
    except PermissionError:
        return "unreadable", None
    except (OSError, UnicodeError):
        return "invalid", None
    finally:
        os.close(fd)


def read_json(path):
    state, text = read_bounded(path)
    if state != "ok":
        return state, None
    try:
        return "ok", json.loads(text)
    except ValueError:
        return "invalid", None


def write_atomic(path, text):
    parent = os.path.dirname(path) or "."
    os.makedirs(parent, mode=0o700, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=parent, prefix=".tmp-llmgw-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def safe_write(path, text):
    """狀態檔寫入失敗不該弄垮守護程式（唯讀 STATE_DIR 時照樣連線）；回是否成功。"""
    try:
        write_atomic(path, text)
        return True
    except OSError:
        return False


def state_path(cfg, name):
    return os.path.join(cfg["state_dir"], name)


def known_hosts_path(cfg):
    return state_path(cfg, ".tunnel_known_hosts")


def read_follow(cfg):
    """本機 FOLLOW_FILE → ("ok", 欄位) / ("missing"|"invalid", None)。"""
    state, data = read_json(cfg["follow_file"])
    if state != "ok":
        return ("missing" if state == "missing" else "invalid"), None
    try:
        return "ok", validate_follow(data, cfg["local_user"])
    except ValueError:
        return "invalid", None


def read_verified(cfg):
    """.tunnel_generation → ("ok", {"generation", "fingerprint"}) /
    ("missing", None)（真的不存在＝首次）/ ("invalid"|"unreadable", None)。
    後兩者不可當成首次啟動：呼叫端一律 fail-closed。"""
    state, data = read_json(state_path(cfg, ".tunnel_generation"))
    if state != "ok":
        return state, None
    if not isinstance(data, dict):
        return "invalid", None
    gen = data.get("generation")
    fp = data.get("fingerprint")
    if isinstance(gen, bool) or not isinstance(gen, int) or gen < 0 \
            or not isinstance(fp, str) or FINGERPRINT_RE.fullmatch(fp) is None:
        return "invalid", None
    return "ok", {"generation": gen, "fingerprint": fp}


def write_verified(cfg, fields):
    """寫已驗證水位；回是否成功（失敗時呼叫端不可當成已記錄）。"""
    return safe_write(state_path(cfg, ".tunnel_generation"), json.dumps(
        {"generation": fields["generation"], "fingerprint": fingerprint(fields)}))


def read_backoff(cfg):
    state, data = read_json(state_path(cfg, ".tunnel_fetch_backoff"))
    if state != "ok" or not isinstance(data, dict):
        return 0.0, 0
    nxt = data.get("next_allowed_epoch")
    failures = data.get("consecutive_failures")
    if isinstance(nxt, bool) or not isinstance(nxt, (int, float)):
        nxt = 0.0
    if isinstance(failures, bool) or not isinstance(failures, int) or failures < 0:
        failures = 0
    return float(nxt), failures


def write_backoff(cfg, next_allowed, failures):
    return safe_write(state_path(cfg, ".tunnel_fetch_backoff"), json.dumps(
        {"next_allowed_epoch": next_allowed, "consecutive_failures": failures}))


def write_fetch_state(cfg, status):
    if status in FETCH_CLASSES:
        safe_write(state_path(cfg, ".tunnel_fetch_state"),
                   json.dumps({"status": status, "ts": int(time.time())}))


def utc_iso(epoch):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(epoch))


# ---------------------------------------------------------------------------
# ssh 命令列
# ---------------------------------------------------------------------------

def _ssh_common(cfg, target):
    """-l <本機使用者> -- <正規化主機>：使用者與主機都不可能被 ssh 當成選項。"""
    return [
        "-i", cfg["identity"],
        "-o", "UserKnownHostsFile=" + target["known_hosts"],
        "-o", "GlobalKnownHostsFile=/dev/null",
        "-o", "IdentitiesOnly=yes",
        "-o", "StrictHostKeyChecking=yes",
        "-o", "BatchMode=yes",
        "-o", "ConnectTimeout=%d" % cfg["connect_timeout"],
        "-p", str(target["port"]),
        "-l", cfg["local_user"],
        "--", target["host"],
    ]


def tunnel_argv(cfg, target):
    return [
        cfg["ssh_path"], "-N",
        "-R", "127.0.0.1:%d:127.0.0.1:%d" % (cfg["remote_api"], cfg["local_api"]),
        "-R", "127.0.0.1:%d:127.0.0.1:22" % cfg["remote_ssh"],
        "-o", "ExitOnForwardFailure=yes",
        "-o", "ServerAliveInterval=%d" % cfg["alive_interval"],
        "-o", "ServerAliveCountMax=%d" % cfg["alive_count"],
    ] + _ssh_common(cfg, target)


def probe_argv(cfg, target):
    return [
        cfg["ssh_path"],
        "-W", "127.0.0.1:%d" % cfg["remote_api"],
    ] + _ssh_common(cfg, target)


def probe_healthy(cfg, target):
    argv = probe_argv(cfg, target)
    try:
        proc = subprocess.Popen(
            argv,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
    except OSError:
        return False
    timeout = max(2.0, min(cfg["probe_interval"], 30.0))
    try:
        out, _ = proc.communicate(PROBE_REQUEST, timeout=timeout)
    except subprocess.TimeoutExpired:
        proc.kill()
        try:
            proc.communicate(timeout=5)
        except subprocess.TimeoutExpired:
            pass
        return False
    status_line = out.split(b"\n", 1)[0].strip()
    parts = status_line.split()
    return len(parts) >= 2 and parts[0].startswith(b"HTTP/") and parts[1] == b"200"


# ---------------------------------------------------------------------------
# 目標位址的選擇
# ---------------------------------------------------------------------------

def follow_status(cfg):
    """FOLLOW_FILE 的狀態（與 lgwctl 六態中的 ok／missing／invalid／regressed 對應；
    已驗證水位本身壞掉時回 verified_invalid／verified_unreadable）。

    回 (狀態, 欄位或 None)。regressed＝generation 低於已驗證水位；同代但指紋與
    已驗證不同算 invalid。"""
    state, fields = read_follow(cfg)
    if state != "ok":
        return state, None
    verified_state, verified = read_verified(cfg)
    if verified_state in ("invalid", "unreadable"):
        return "verified_" + verified_state, None        # 水位壞了＝無從比對，fail-closed
    if verified is not None:
        if fields["generation"] < verified["generation"]:
            return "regressed", None
        if fields["generation"] == verified["generation"] \
                and fingerprint(fields) != verified["fingerprint"]:
            return "invalid", None
    return "ok", fields


def follow_target(cfg, fields):
    return {"host": fields["ip"], "port": fields["ssh_port"],
            "known_hosts": known_hosts_path(cfg), "follow": fields}


def choose_target(cfg, write=True, notify=True):
    """啟動時用哪個位址：有效 FOLLOW_FILE 優先，其次初始 RENDEZVOUS＋KNOWN_HOSTS，
    都沒有回 None（呼叫端同行程去抓）。write=False（--probe-once）時不寫任何檔，
    私用 known_hosts 缺或不符就回 None。"""
    state, fields = follow_status(cfg)
    if state == "ok":
        target = follow_target(cfg, fields)
        expected = known_hosts_line(fields)
        current = read_bounded(target["known_hosts"])
        if current != ("ok", expected):
            if not write:
                return None
            # 私用 known_hosts 由已驗證的 FOLLOW_FILE 決定，缺漏／被改時重寫
            if not safe_write(target["known_hosts"], expected):
                return None
        return target
    if notify and cfg["follow_file"] and (state != "missing" or cfg["github"]):
        log(FOLLOW_STATE_EVENTS[state])
    if cfg["static"] is not None:
        return dict(cfg["static"])
    return None


# ---------------------------------------------------------------------------
# 向 GitHub 抓 NODE_GATEWAY（只在連不上時；標準函式庫 urllib）
# ---------------------------------------------------------------------------

class FetchError(Exception):
    """抓取／驗證失敗；args[0] 是固定分類（FETCH_CLASSES 之一），不含任何敏感文字。"""

    def __init__(self, cls, retry_after=None):
        super().__init__(cls)
        self.cls = cls
        self.retry_after = retry_after


class _SameHostRedirect(urllib.request.HTTPRedirectHandler):
    """只跟隨同協定同主機的轉址；其他一律當 HTTPError（Authorization 不外送）。"""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        old = urllib.parse.urlsplit(req.full_url)
        new = urllib.parse.urlsplit(urllib.parse.urljoin(req.full_url, newurl))
        if (new.scheme, new.hostname, new.port or 0) != (old.scheme, old.hostname, old.port or 0):
            return None
        return super().redirect_request(req, fp, code, msg, headers, newurl)


def read_token(cfg):
    """token 只在記憶體：優先 $CREDENTIALS_DIRECTORY/gateway-token，否則 GATEWAY_GITHUB_KEY_FILE。"""
    paths = []
    cred_dir = os.environ.get("CREDENTIALS_DIRECTORY")
    if cred_dir:
        candidate = os.path.join(cred_dir, "gateway-token")
        if os.path.lexists(candidate):
            paths.append(candidate)
    if not paths:
        paths.append(cfg["key_file"])
    try:
        fd = os.open(paths[0], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        try:
            if not stat.S_ISREG(os.fstat(fd).st_mode):
                raise FetchError("credential_unreadable")
            raw = os.read(fd, 8192)
        finally:
            os.close(fd)
        token = raw.decode("ascii").strip()
    except (OSError, UnicodeError):
        raise FetchError("credential_unreadable") from None
    if TOKEN_RE.fullmatch(token) is None:
        raise FetchError("credential_unreadable")
    return token


def retry_delay(headers, now):
    """Retry-After（秒或日期）與 X-RateLimit-Reset（限流用盡時）換成等待秒數；沒有回 None。"""
    delays = []
    value = headers.get("Retry-After")
    if value:
        value = value.strip()
        try:
            delays.append(float(int(value)))
        except ValueError:
            try:
                delays.append(parsedate_to_datetime(value).timestamp() - now)
            except (TypeError, ValueError, OverflowError):
                pass
    if (headers.get("X-RateLimit-Remaining") or "").strip() == "0":
        try:
            delays.append(float(int((headers.get("X-RateLimit-Reset") or "").strip())) - now)
        except ValueError:
            pass
    delays = [d for d in delays if d > 0]
    return min(max(delays), RETRY_AFTER_CEILING) if delays else None


def classify_status(code, headers, now):
    """非 200 的 HTTP 狀態 → 固定分類。"""
    if code == 429:
        return FetchError("rate_limited", retry_delay(headers, now))
    if code == 403:
        limited = (headers.get("X-RateLimit-Remaining") or "").strip() == "0" or headers.get("Retry-After")
        if limited:
            return FetchError("rate_limited", retry_delay(headers, now))
        return FetchError("auth_failed")
    if code == 401:
        return FetchError("auth_failed")
    if 300 <= code < 400:
        return FetchError("invalid")          # 不跟隨的轉址（含跨主機）
    return FetchError("unreachable")


def http_get(cfg, token):
    """單次 GET；回 (回應文字 bytes, 標頭 dict)。失敗擲 FetchError。"""
    url = "%s/repos/%s/%s" % (cfg["api_base"], cfg["repo"], cfg["source_path"])
    request = urllib.request.Request(url, headers={
        "Authorization": "Bearer " + token,
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
        "User-Agent": "llmgateway-tunnel",
    })
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), _SameHostRedirect)
    deadline = time.monotonic() + cfg["fetch_timeout"]
    now = time.time()
    try:
        with opener.open(request, timeout=cfg["fetch_timeout"]) as response:
            body = b""
            while len(body) <= MAX_RESPONSE_BYTES:
                if time.monotonic() > deadline:
                    raise FetchError("unreachable")
                chunk = response.read(4096)
                if not chunk:
                    break
                body += chunk
            if len(body) > MAX_RESPONSE_BYTES:
                raise FetchError("invalid")
            return body, {k.lower(): v for k, v in response.headers.items()}
    except urllib.error.HTTPError as err:
        headers = err.headers
        err.close()
        raise classify_status(err.code, headers, now) from None
    except FetchError:
        raise
    except (urllib.error.URLError, OSError, http.client.HTTPException, ValueError):
        raise FetchError("unreachable") from None


def parse_gateway_response(body, local_user):
    """Variables API 外層 {"value": "<JSON 字串>"} → 驗證過的連線欄位；擲 FetchError。"""
    try:
        outer = json.loads(body.decode("utf-8"))
        value = outer["value"] if isinstance(outer, dict) else None
        inner = json.loads(value) if isinstance(value, str) else None
    except (ValueError, UnicodeError, KeyError):
        raise FetchError("invalid") from None
    try:
        return validate_gateway(inner, local_user)
    except ValueError as err:
        cls = str(err)
        raise FetchError(cls if cls in ("invalid", "hostkey_missing") else "invalid") from None


def parse_expiry(header, fetched_at):
    """github-authentication-token-expiration（如 ``2026-02-01 00:00:00 UTC``）→ UTC epoch；
    缺、壞、≤ 抓取當下時間（GitHub 曾回等於現在的怪值）都回 None＝expiry_unknown。"""
    if not header:
        return None
    text = header.strip()
    if text.endswith(" UTC"):
        text = text[:-4] + "+00:00"
    elif text.endswith("Z"):
        text = text[:-1] + "+00:00"
    try:
        moment = datetime.datetime.fromisoformat(text)
    except ValueError:
        return None
    if moment.tzinfo is None:
        moment = moment.replace(tzinfo=datetime.timezone.utc)
    try:
        stamp = moment.timestamp()
    except (OverflowError, OSError, ValueError):
        return None
    return stamp if stamp > fetched_at else None


def fetch_gateway(cfg):
    """抓一次並驗證；回 (欄位, 標頭)。失敗擲 FetchError。不寫任何檔。"""
    token = read_token(cfg)
    body, headers = http_get(cfg, token)
    return parse_gateway_response(body, cfg["local_user"]), headers


def write_token_meta(cfg, headers, fetched_at):
    meta = {"http_status": 200, "fetched_at": utc_iso(fetched_at)}
    expiry = parse_expiry(headers.get("github-authentication-token-expiration"), fetched_at)
    if expiry is not None:
        meta["expires_at"] = utc_iso(expiry)
    safe_write(state_path(cfg, ".tunnel_token_meta"), json.dumps(meta))


def record_failure(cfg, cls, retry_after=None, event=None):
    """抓取失敗或被拒：寫分類、累加連敗、依指數退避（FETCH_MIN_INTERVAL×2^n，上限
    FETCH_BACKOFF_MAX）與 Retry-After／X-RateLimit-Reset 取大者設下次允許時間。"""
    _, failures = read_backoff(cfg)
    failures += 1
    delay = min(cfg["fetch_max"], cfg["fetch_min"] * (2 ** min(failures - 1, 20)))
    if retry_after:
        delay = max(delay, retry_after)
    write_backoff(cfg, time.time() + delay, failures)
    write_fetch_state(cfg, cls)
    log(event or FAIL_EVENTS.get(cls, "fetch_failed"))


def fetch_check():
    """人工驗收（P4.2）：單次請求、嚴格只讀、不印位址／金鑰／token。"""
    path = config_path()
    cfg = load_config(path) if path else None
    if cfg is None or not cfg["github"]:
        print("config_missing")
        return EXIT_CONFIG_MISSING
    try:
        fields, headers = fetch_gateway(cfg)
    except FetchError as err:
        print("fetch_check: failed (%s)" % err.cls)
        return EXIT_FAILED
    print("fetch_check: ok")
    print("http_status: 200")
    print("format: ok")
    print("generation: %d" % fields["generation"])
    expiry = headers.get("github-authentication-token-expiration")
    print("expiry_header: %s" % ("present" if parse_expiry(expiry, time.time()) else "absent"))
    print(FETCH_CHECK_HINT)
    return 0


# ---------------------------------------------------------------------------
# 守護程式
# ---------------------------------------------------------------------------

class Runtime:
    """行程內共用狀態：收到 SIGTERM／SIGINT 的旗標與目前的 ssh 子行程。"""

    def __init__(self):
        self.shutdown = False
        self.child = None
        self.lock = threading.Lock()

    def request_shutdown(self):
        self.shutdown = True
        with self.lock:
            child = self.child
        if child is not None and child.poll() is None:
            child.terminate()


def run_session(cfg, rt, target):
    """以 target 建隧道並盯到它結束；回 "shutdown"／"spawn_fail"／"lost"。"""
    try:
        tunnel = subprocess.Popen(
            tunnel_argv(cfg, target),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError:
        log("spawn_fail")
        return "spawn_fail"
    with rt.lock:
        rt.child = tunnel
    if rt.shutdown:
        tunnel.terminate()
    log("tunnel_up")
    stop = threading.Event()
    applied = target["follow"]

    def watch():
        fails = 0
        recorded = applied is None
        mark_state = None            # 上一次 mark_verified 的非成功結果（同一種只記一次）
        seen = set()                 # 本連線已記過的狀態事件（不洗版）

        def note(event):
            if event not in seen:
                seen.add(event)
                log(event)
        delay = min(2.0, cfg["probe_interval"])    # 新連線盡快驗通；之後照 PROBE_INTERVAL
        flagged = False
        while not stop.wait(delay):
            delay = cfg["probe_interval"]
            if probe_healthy(cfg, target):
                fails = 0
                if not recorded:
                    result = mark_verified(cfg, applied)
                    if result == "ok":
                        recorded = True
                    elif result != mark_state:
                        mark_state = result
                        note(result)          # verified_invalid／unreadable／write_failed
            else:
                fails += 1
                log("probe_fail")
                if fails >= cfg["probe_fails"]:
                    log("restart")
                    stop.set()
                    if tunnel.poll() is None:
                        tunnel.terminate()
                    return
            if applied is not None and not flagged:
                state = follow_status(cfg)[0]
                if state != "ok":
                    flagged = True       # 只在狀態轉換記一次，不打斷健康的 ssh
                    note(FOLLOW_STATE_EVENTS[state])

    watcher = threading.Thread(target=watch, daemon=True)
    watcher.start()
    tunnel.wait()
    stop.set()
    watcher.join(timeout=5)
    with rt.lock:
        rt.child = None
    return "shutdown" if rt.shutdown else "lost"


def mark_verified(cfg, fields):
    """首次端對端探針 200 後才寫 .tunnel_generation，並把連敗計數歸零。

    回 "ok"（水位已是最新且退避已清）或固定事件名：水位壞了／讀不到（不覆寫，
    verified_invalid／verified_unreadable）、寫入失敗（verified_write_failed）。
    非 "ok" 時呼叫端不得當成完成，之後的探針會再試。"""
    state, verified = read_verified(cfg)
    if state in ("invalid", "unreadable"):
        return "verified_" + state
    if verified is None or verified["generation"] != fields["generation"] \
            or verified["fingerprint"] != fingerprint(fields):
        if not write_verified(cfg, fields):
            return "verified_write_failed"
    nxt, failures = read_backoff(cfg)
    if failures and not write_backoff(cfg, nxt, 0):
        return "verified_write_failed"
    return "ok"


def apply_gateway(cfg, fields, now):
    """原子寫私用 known_hosts 與 FOLLOW_FILE；回新的 target，寫不進去回 None。"""
    stored = dict(fields)
    stored["published_at"] = fields["published_at"] or utc_iso(now)
    if not safe_write(known_hosts_path(cfg), known_hosts_line(fields)):
        return None
    record = {"ip": stored["ip"], "ssh_port": stored["ssh_port"],
              "tunnel_user": stored["tunnel_user"], "host_key": stored["host_key"],
              "generation": stored["generation"], "published_at": stored["published_at"]}
    if not safe_write(cfg["follow_file"], json.dumps(record)):
        return None
    return follow_target(cfg, stored)


def acquire(cfg, rt):
    """連不上時的同行程取得新位址（design §4.4 步驟 3）；回新的 target 或 None
    （呼叫端以 1 結束，由 systemd 帶起、沿用最後已知位址重試）。"""
    if not cfg["github"] or rt.shutdown:
        return None
    now = time.time()
    next_allowed, _ = read_backoff(cfg)
    if now < next_allowed:
        log("fetch_skipped")
        return None
    try:
        fields, headers = fetch_gateway(cfg)
    except FetchError as err:
        record_failure(cfg, err.cls, err.retry_after)
        return None
    if rt.shutdown:
        return None
    write_token_meta(cfg, headers, now)
    log("fetch_ok")
    generation = fields["generation"]
    fp = fingerprint(fields)
    verified_state, verified = read_verified(cfg)
    if verified_state in ("invalid", "unreadable"):
        # 水位壞了／讀不到不是首次啟動：不套用、不覆寫水位，等操作人處理
        record_failure(cfg, "invalid", event="verified_" + verified_state)
        return None
    applied = read_follow(cfg)[1]
    if verified is not None and generation < verified["generation"]:
        record_failure(cfg, "regressed")                                  # 規則 1
        return None
    if applied is not None and generation == applied["generation"] and same_fields(fields, applied):
        # 規則 2：未換代（閃斷，或新代套用了但還沒驗通又抓到同一份）
        write_fetch_state(cfg, "ok")
        _, failures = read_backoff(cfg)
        write_backoff(cfg, now + cfg["fetch_min"], failures)
        if verified is None or verified["generation"] != generation or verified["fingerprint"] != fp:
            log("unverified_retry")
        return None
    reverted = verified is not None and generation == verified["generation"]
    if reverted and fp != verified["fingerprint"]:
        record_failure(cfg, "invalid", event="follow_invalid")           # 規則 4（同代改欄位）
        return None
    if applied is not None and generation == applied["generation"]:
        record_failure(cfg, "invalid", event="follow_invalid")           # 規則 4（同代改欄位）
        return None
    target = apply_gateway(cfg, fields, now)                              # 規則 3／5
    if target is None:
        record_failure(cfg, "unreachable")
        return None
    write_fetch_state(cfg, "ok")
    _, failures = read_backoff(cfg)
    write_backoff(cfg, now + cfg["fetch_min"], failures)
    log("gateway_reverted_to_verified" if reverted else "gateway_updated")
    return target


def daemon():
    path = config_path()
    cfg = load_config(path) if path else None
    if cfg is None:
        log("config_missing")
        return EXIT_CONFIG_MISSING
    rt = Runtime()

    def on_signal(signum, frame):
        rt.request_shutdown()

    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)
    if cfg["github_partial"]:
        log("config_partial")
        write_fetch_state(cfg, "config_partial")
    target = choose_target(cfg)
    while True:
        if rt.shutdown:
            return 0
        if target is None:
            target = acquire(cfg, rt)
            if target is None:
                return 0 if rt.shutdown else EXIT_FAILED
        outcome = run_session(cfg, rt, target)
        if outcome == "shutdown":
            return 0
        if outcome == "spawn_fail":
            return EXIT_FAILED
        target = acquire(cfg, rt)
        if target is None:
            return 0 if rt.shutdown else EXIT_FAILED


def probe_once():
    """一次端對端探針；回 0＝HTTP 200、1＝不是 200 或沒回應、2＝無法執行。
    嚴格只讀：不建立或改寫任何狀態檔、不打 GitHub、不寫 log。"""
    path = config_path()
    cfg = load_config(path) if path else None
    if cfg is None:
        return EXIT_PROBE_UNAVAILABLE
    if shutil.which(cfg["ssh_path"]) is None:
        return EXIT_PROBE_UNAVAILABLE
    target = choose_target(cfg, write=False, notify=False)
    if target is None:
        return EXIT_PROBE_UNAVAILABLE
    return EXIT_PROBE_OK if probe_healthy(cfg, target) else EXIT_PROBE_FAIL


def main():
    if sys.argv[1:] == ["--probe-once"]:
        return probe_once()
    if sys.argv[1:] == ["--fetch-check"]:
        return fetch_check()
    return daemon()


if __name__ == "__main__":
    sys.exit(main())
