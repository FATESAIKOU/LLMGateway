def parse_env_file(path):
    values = {}
    try:
        with open(path, "r", encoding="utf-8") as f:
            lines = f.read().splitlines()
    except (OSError, UnicodeError):
        return values
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[len("export "):].lstrip()
        key, sep, value = line.partition("=")
        if not sep:
            continue
        key = key.strip()
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
            value = value[1:-1]
        if key:
            values[key] = value
    return values


def parse_rendezvous(value):
    """``[user@]host:port`` → (user 或 None, host, port)；host 一律走嚴格驗證。"""
    host_part, sep, port_text = value.rpartition(":")
    if not sep or not host_part:
        return None
    user = None
    if "@" in host_part:
        user, _, host_part = host_part.rpartition("@")
        if not valid_user(user):
            return None
    try:
        host = validate_host(host_part)
        port = int(port_text)
    except ValueError:
        return None
    if not port_text.isascii() or not port_text.isdigit() or not 1 <= port <= 65535:
        return None
    return user, host, port


def config_path():
    """設定檔路徑：LGW_TUNNEL_ENV 優先（給 system unit 用），否則 ~/.config/...。"""
    override = (os.environ.get(ENV_CONFIG) or "").strip()
    if override:
        return override
    home = os.environ.get("HOME")
    if not home:
        return None
    return os.path.join(home, CONFIG_REL)


def state_dir():
    return (os.environ.get(ENV_STATE_DIR) or "").strip() or DEFAULT_STATE_DIR


def api_base():
    """正式只認 https://api.github.com；測試旗標＋loopback 才能換。回 None＝未授權（78）。"""
    override = os.environ.get(ENV_API_BASE)
    if override is None or override == "":
        return GITHUB_API_BASE
    if os.environ.get(ENV_ALLOW_INSECURE) != "1":
        return None
    try:
        parts = urllib.parse.urlsplit(override)
        host = parts.hostname
        parts.port  # 觸發埠號驗證
    except ValueError:
        return None
    if parts.scheme not in ("http", "https") or host not in ("127.0.0.1", "::1", "localhost"):
        return None
    if parts.username or parts.password or parts.path not in ("", "/") or parts.query or parts.fragment:
        return None
    return override.rstrip("/")


def load_config(path):
    """回設定 dict；設定本身不能啟動時回 None（呼叫端以 78 結束）。"""
    values = parse_env_file(path)
    if not values.get("IDENTITY"):
        return None
    rendezvous = None
    if values.get("RENDEZVOUS"):
        rendezvous = parse_rendezvous(values["RENDEZVOUS"])
        if rendezvous is None:
            return None
    explicit = values.get("TUNNEL_USER") or None
    if explicit is not None and not valid_user(explicit):
        return None
    rv_user = rendezvous[0] if rendezvous else None
    if explicit and rv_user and explicit != rv_user:
        return None
    local_user = rv_user or explicit
    if not local_user:
        return None
    merged = {}
    for key, default in DEFAULTS.items():
        merged[key] = values.get(key) or default
    try:
        remote_api = int(merged["REMOTE_API"])
        remote_ssh = int(merged["REMOTE_SSH"])
        local_api = int(merged["LOCAL_API"])
        probe_interval = float(merged["PROBE_INTERVAL"])
        probe_fails = int(merged["PROBE_FAILS"])
        connect_timeout = int(merged["SSH_CONNECT_TIMEOUT"])
        alive_interval = int(merged["SERVER_ALIVE_INTERVAL"])
        alive_count = int(merged["SERVER_ALIVE_COUNT_MAX"])
        fetch_timeout = float(merged["FETCH_TIMEOUT"])
        fetch_min = float(merged["FETCH_MIN_INTERVAL"])
        fetch_max = float(merged["FETCH_BACKOFF_MAX"])
    except ValueError:
        return None
    for port in (remote_api, remote_ssh, local_api):
        if not 1 <= port <= 65535:
            return None
    if probe_interval <= 0 or probe_fails < 1 or connect_timeout < 1 or alive_interval < 1 \
            or alive_count < 1 or fetch_timeout <= 0 or fetch_min <= 0 or fetch_max < fetch_min:
        return None
    base = api_base()
    if base is None:
        return None
    github_set = [bool(values.get(key)) for key in GITHUB_KEYS]
    github_complete = all(github_set)
    github_partial = any(github_set) and not github_complete
    if github_complete:
        if not REPO_RE.fullmatch(values["GATEWAY_SOURCE_REPO"]) \
                or not PATH_RE.fullmatch(values["GATEWAY_SOURCE_PATH"]) \
                or {".", ".."} & set(values["GATEWAY_SOURCE_REPO"].split("/")
                                     + values["GATEWAY_SOURCE_PATH"].split("/")):
            return None
    sdir = state_dir()
    cfg = {
        "identity": values["IDENTITY"],
        "known_hosts": values.get("KNOWN_HOSTS") or "",
        "remote_api": remote_api,
        "remote_ssh": remote_ssh,
        "local_api": local_api,
        "probe_interval": probe_interval,
        "probe_fails": probe_fails,
        "ssh_path": merged["SSH_PATH"],
        "connect_timeout": connect_timeout,
        "alive_interval": alive_interval,
        "alive_count": alive_count,
        "fetch_timeout": fetch_timeout,
        "fetch_min": fetch_min,
        "fetch_max": fetch_max,
        "local_user": local_user,
        "static": None,
        "github": github_complete,
        "github_partial": github_partial,
        "repo": values.get("GATEWAY_SOURCE_REPO", ""),
        "source_path": values.get("GATEWAY_SOURCE_PATH", ""),
        "key_file": values.get("GATEWAY_GITHUB_KEY_FILE", ""),
        "api_base": base,
        "state_dir": sdir,
        "follow_file": values.get("FOLLOW_FILE") or os.path.join(sdir, "gateway.json"),
    }
    if rendezvous is not None and cfg["known_hosts"]:
        cfg["static"] = {"host": rendezvous[1], "port": rendezvous[2],
                         "known_hosts": cfg["known_hosts"], "follow": None}
    if cfg["static"] is None and not cfg["github"] and read_follow(cfg)[0] != "ok":
        return None
    return cfg


# ---------------------------------------------------------------------------
# 欄位驗證（純函式；NODE_GATEWAY 與本機 FOLLOW_FILE 共用）
# ---------------------------------------------------------------------------

def valid_user(value):
    return isinstance(value, str) and USER_RE.fullmatch(value) is not None


def validate_host(value):
    """回正規化後的主機字串（IP 用 str(addr)、主機名轉小寫）；不合法擲 ValueError。"""
    if not isinstance(value, str) or not value or "%" in value:
        raise ValueError("host")
    try:
        addr = ipaddress.ip_address(value)
    except ValueError:
        addr = None
    if addr is not None:
        if getattr(addr, "scope_id", None) is not None:
            raise ValueError("host")
        return str(addr)
    if HOST_RE.fullmatch(value) is None:
        raise ValueError("host")
    if value.rsplit(".", 1)[-1].isdigit():
        # 最後一個 label 全為數字：ssh／inet_aton 會把它當成別種位址寫法
        raise ValueError("host")
    return value.lower()


def validate_port(value, default=None):
    if value is None:
        if default is None:
            raise ValueError("port")
        return default
    if isinstance(value, bool) or not isinstance(value, int) or not 1 <= value <= 65535:
        raise ValueError("port")
    return value


def validate_generation(value):
    if isinstance(value, bool):
        raise ValueError("generation")
    if isinstance(value, int):
        if value < 0:
            raise ValueError("generation")
        return value
    if isinstance(value, str) and GENERATION_RE.fullmatch(value):
        return int(value)
    raise ValueError("generation")


_EC_CURVES = {
    # name: (p, b, 座標位元組數)；a = -3
    "nistp256": (2 ** 256 - 2 ** 224 + 2 ** 192 + 2 ** 96 - 1,
                 0x5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b, 32),
    "nistp384": (2 ** 384 - 2 ** 128 - 2 ** 96 + 2 ** 32 - 1,
                 int("b3312fa7e23ee7e4988e056be3f82d19181d9c6efe8141120314088f5013875a"
                     "c656398d8a2ed19d2a85c8edd3ec2aef", 16), 48),
    "nistp521": (2 ** 521 - 1,
                 int("0051953eb9618e1c9a1f929a21a0b68540eea2da725b99b315f3b8b489918ef1"
                     "09e156193951ec7e937b1652c0bd3bb1bf073573df883d2c34f1ef451fd46b50"
                     "3f00", 16), 66),
}


def _mpint_value(raw):
    """SSH mpint（正、最短編碼）→ int；不合擲 ValueError。"""
    if not raw or raw[0] & 0x80 or (raw[0] == 0 and (len(raw) == 1 or not raw[1] & 0x80)):
        raise ValueError()
    return int.from_bytes(raw, "big")


def _check_key_material(kind, fields):
    """依金鑰型別驗 wire-format 欄位（OpenSSH 實際接受的條件，且不寬於它）。"""
    if kind == "ssh-ed25519":
        if len(fields) != 2 or len(fields[1]) != 32:
            raise ValueError()
    elif kind == "ssh-rsa":
        if len(fields) != 3:
            raise ValueError()
        e, n = _mpint_value(fields[1]), _mpint_value(fields[2])
        if not 1024 <= n.bit_length() <= 16384 or n % 2 == 0 or e < 3 or e % 2 == 0 or e >= n:
            raise ValueError()
    else:
        curve = kind.removeprefix("ecdsa-sha2-")
        if len(fields) != 3 or fields[1] != curve.encode() or curve not in _EC_CURVES:
            raise ValueError()
        p, b, size = _EC_CURVES[curve]
        point = fields[2]
        if len(point) != 1 + 2 * size or point[0] != 4:
            raise ValueError()
        x = int.from_bytes(point[1:1 + size], "big")
        y = int.from_bytes(point[1 + size:], "big")
        if x >= p or y >= p or (y * y - (x * x * x - 3 * x + b)) % p:
            raise ValueError()


def validate_host_key(value):
    """單行兩欄、base64 正規往返、完整 OpenSSH wire-format；回原字串。"""
    if not isinstance(value, str):
        raise ValueError("host_key")
    match = HOSTKEY_RE.fullmatch(value)
    if match is None:
        raise ValueError("host_key")
    kind, encoded = match.group(1), match.group(2)
    try:
        blob = base64.b64decode(encoded, validate=True)
        if base64.b64encode(blob).decode("ascii") != encoded:
            raise ValueError("host_key")
        index = 0
        fields = []
        while index < len(blob):
            if index + 4 > len(blob):
                raise ValueError("host_key")
            length = struct.unpack_from(">I", blob, index)[0]
            index += 4
            if length == 0 or index + length > len(blob):
                raise ValueError("host_key")
            fields.append(blob[index:index + length])
            index += length
    except (binascii.Error, struct.error):
        raise ValueError("host_key") from None
    if not fields or fields[0] != kind.encode():
        raise ValueError("host_key")
    _check_key_material(kind, fields)
    return value


def validate_gateway(data, local_user):
    """NODE_GATEWAY 內層 JSON → 正規化的連線欄位；不合擲 ValueError(分類)。

    分類：host_key 問題＝hostkey_missing，其餘＝invalid。其他欄位（user、
    key_secret、ssh_listen_ports、ports…）一律忽略。
    """
    if not isinstance(data, dict):
        raise ValueError("invalid")
    try:
        key = validate_host_key(data.get("host_key"))
    except ValueError:
        raise ValueError("hostkey_missing") from None
    try:
        host = validate_host(data.get("ip"))
        port = validate_port(data.get("port"), default=22)
        user = data.get("tunnel_user")
        if not valid_user(user) or user != local_user:
            raise ValueError("tunnel_user")
        generation = validate_generation(data.get("generation"))
    except ValueError:
        raise ValueError("invalid") from None
    published = data.get("published_at", data.get("rotated_at"))
    if not isinstance(published, str) or PUBLISHED_RE.fullmatch(published) is None:
        published = None
    return {"ip": host, "ssh_port": port, "tunnel_user": user, "host_key": key,
            "generation": generation, "published_at": published}


def validate_follow(data, local_user):
    """本機 FOLLOW_FILE（我們自己寫的正規化格式）→ 欄位 dict；不合擲 ValueError。"""
    if not isinstance(data, dict):
        raise ValueError("invalid")
    port = data.get("ssh_port")
    if port is None:
        raise ValueError("invalid")
    generation = data.get("generation")
    if isinstance(generation, bool) or not isinstance(generation, int):
        raise ValueError("invalid")
    try:
        fields = validate_gateway({"ip": data.get("ip"), "port": port,
                                   "tunnel_user": data.get("tunnel_user"),
                                   "host_key": data.get("host_key"),
                                   "generation": generation}, local_user)
    except ValueError:
        raise ValueError("invalid") from None
    if fields["ip"] != data.get("ip"):
        raise ValueError("invalid")           # 我們寫的一定是正規化形式
    fields["published_at"] = data.get("published_at") if isinstance(data.get("published_at"), str) else None
    return fields


def fingerprint(fields):
    """與 lgwctl.layout.follow_fingerprint 相同：[ip, ssh_port, tunnel_user, host_key]
    以 ensure_ascii、無空白分隔的 JSON → UTF-8 → SHA-256 十六進位。"""
    payload = [fields["ip"], fields["ssh_port"], fields["tunnel_user"], fields["host_key"]]
    return hashlib.sha256(
        json.dumps(payload, ensure_ascii=True, separators=(",", ":")).encode()).hexdigest()


def same_fields(a, b):
    return all(a[k] == b[k] for k in ("ip", "ssh_port", "tunnel_user", "host_key"))


def known_hosts_line(fields):
    host = fields["ip"]
    pattern = host if fields["ssh_port"] == 22 else "[%s]:%d" % (host, fields["ssh_port"])
    return "%s %s\n" % (pattern, fields["host_key"])


