#!/usr/bin/env python3
"""Fetch and validate the independent role rotation table."""
import base64
import json
import os
import subprocess
import signal
import sys
import tempfile
import time

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, ROOT)
from lgwd.policy import load_policy
from lgwd.roletable import parse, RoleTableError

def atomic(path, data, mode):
    fd, tmp = tempfile.mkstemp(prefix='.rolesync-', dir=os.path.dirname(path))
    try:
        with os.fdopen(fd, 'wb') as f:
            f.write(data); f.flush(); os.fsync(f.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp): os.unlink(tmp)

def _terminate(_signum, _frame):
    # Interrupt subprocess.run, which kills and reaps its own gh child before unwinding.
    raise RuntimeError("terminated")

def main():
    signal.signal(signal.SIGTERM, _terminate)
    prefix = os.environ.get('LLMGW_PREFIX', '').rstrip('/')
    directory = prefix + '/var/lib/llmgateway'
    path = os.path.join(directory, 'role-rotation.json')
    status = os.path.join(directory, '.rolesync.status')
    sha_path = os.path.join(directory, '.rolesync.sha')
    ever = False
    try:
        with open(status) as f: ever = json.load(f).get('ever_ok') is True
    except (OSError, ValueError, AttributeError): pass
    reason = 'unexpected'
    try:
        gh = os.environ.get('LGWSYNC_GH', 'gh')
        try:
            p = subprocess.run([gh, 'api', 'repos/FATESAIKOU/LLMGateway-keys/contents/role-rotation.json'], stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=60)
        except FileNotFoundError:
            raise RuntimeError('gh_missing')
        except subprocess.TimeoutExpired:
            raise RuntimeError('gh_timeout')
        if p.returncode:
            raise RuntimeError('gh_auth' if b'401' in p.stderr or b'403' in p.stderr or b'auth' in p.stderr.lower() else 'gh_failed')
        try:
            response = json.loads(p.stdout)
            raw = base64.b64decode(response['content'].replace('\n',''), validate=True)
            sha = response['sha']
            if not isinstance(sha,str) or not sha or '\n' in sha: raise ValueError()
            parse(raw, load_policy(os.path.join(ROOT, 'policy/default.json')))
        except (ValueError, KeyError, TypeError, RoleTableError):
            raise RuntimeError('validation_failed')
        atomic(path, raw, 0o644)
        atomic(sha_path, (sha+'\n').encode(), 0o600)
        ever, reason = True, 'ok'
    except RuntimeError as exc:
        reason = str(exc)
    except Exception:
        reason = 'unexpected'
    try:
        atomic(status, (json.dumps({'ts':time.time(), 'ok':reason == 'ok', 'reason':reason, 'ever_ok':ever})+'\n').encode(), 0o644)
    except OSError:
        return 1
    return 0 if reason == 'ok' else 1

if __name__ == '__main__': sys.exit(main())
